# ============================================
# SentinelAI Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://luzayer:luzayer@localhost:5432/sentinelai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
JWT_SECRET=vxHAE_60uXimEE5eOOtAKxyOjECN8K74dWmpKgvPZYyqOLQ1xg8Tq_l1AQxeKsZ4
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- Ollama LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./uploads
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.gif,.bmp,.tiff,.webp
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.webm,.flv
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.ogg,.flac,.aac,.m4a
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.rtf
ALLOWED_ARCHIVE_EXTENSIONS=.zip,.tar,.gz,.7z,.rar

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Application ---
APP_NAME=SentinelAI
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# --- Optional External Intelligence ---
# Uncomment and fill in to enable external threat intelligence
# VIRUSTOTAL_API_KEY=
# URLSCAN_API_KEY=
# ABUSEIPDB_API_KEY=
